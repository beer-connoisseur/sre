        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg_over_time((sum(rate(urlshort_prober_runs_total{result=\"success\"}[1m])) / sum(rate(urlshort_prober_runs_total[1m])) >= bool 0.99)[1h:1m])",
